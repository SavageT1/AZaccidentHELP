# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GA_ID: Google Analytics measurement ID, if enabled.
VITE_GA_ID="G-XXXXXXXXXX"

# GOOGLE_SHEETS_WEBHOOK_URL: Optional Google Apps Script web app URL that appends lead rows.
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_WEB_APP_ID/exec"

# GHL_WEBHOOK_URL: Optional GoHighLevel workflow webhook for secure lead delivery.
GHL_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/YOUR_WEBHOOK_ID"

# LEAD_WEBHOOK_SECRET: Optional shared secret sent as X-Webhook-Secret.
LEAD_WEBHOOK_SECRET="replace-with-a-long-random-value"
