# VITE_GA_MEASUREMENT_ID: Google Analytics 4 web stream measurement ID, if enabled.
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# GHL_WEBHOOK_URL: Required server-side GoHighLevel workflow webhook for every lead.
GHL_WEBHOOK_URL="https://services.leadconnectorhq.com/hooks/YOUR_WEBHOOK_ID"

# LEAD_WEBHOOK_SECRET: Optional shared secret sent to the GHL workflow.
LEAD_WEBHOOK_SECRET="replace-with-a-long-random-value"
